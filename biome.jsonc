{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    // Generated artifacts. None of these are written by hand, so formatting
    // them produces enormous diffs that say nothing and would be undone by
    // the next regeneration. Together they were ~12,700 of the ~12,780
    // diagnostics `check` reported, which is why the check had stopped being
    // run at all -- and a check nobody runs is not a check.
    "includes": [
      "!public/wasm",
      // Marks exported as single-line SVG.
      "!public/logo",
      "!src/app/icon.svg",
      // Written by the Tauri CLI.
      "!src-tauri/gen"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        // This is an HDRI (High Dynamic Range Imaging) tool: bitwise
        // operators are the correct, idiomatic tool for WebGPU buffer-usage
        // flag masks (falsecolor-luminance-webgpu.ts), Radiance RLE binary
        // scanline decoding (viewer/view/page.tsx), and byte-size
        // shift constants (generic-image-metadata.ts, tiff-worker.ts).
        // Every current use is a real bitmask/binary-format operation, not
        // a typo for a logical operator, so this rule is disabled globally
        // rather than suppressed inline at ~9 call sites.
        "noBitwiseOperators": "off",

        // Every flagged site in this codebase is a case where the *type* is
        // more confident than runtime reality, in one of two ways, and
        // removing the guard would introduce a crash rather than tidy dead
        // code:
        //
        //  - React refs. `.current` is typed from its initial value, so a
        //    `if (ref.current)` on a DOM ref reads as "always falsy" and a
        //    `if (!dragStateRef.current)` as "always truthy". Both are wrong
        //    the moment the component mounts or a drag starts.
        //    (run-console.tsx, use-image-selection-layer.ts x3)
        //  - Unvalidated reads from storage. `readJson<T>` casts what came
        //    out of IndexedDB to T without checking its shape, so the type
        //    says `presets` is an array while a corrupt document may hold
        //    anything. The `?? []` guards reality, not the type.
        //    (presets.ts, run-history.ts)
        //
        // Also seen resolving the wrong overload of
        // useGenericImageMetadata, where dropping the guard crashes with no
        // image selected, and missing noUncheckedIndexedAccess entirely in
        // falsecolor-luminance-webgpu.ts -- that one already carried an
        // inline suppression before this rule started firing more widely.
        //
        // Seven false positives and no true ones, so this is off globally
        // rather than suppressed at each site. Worth revisiting if Biome
        // learns that a ref's current value is not its initial one.
        "noUnnecessaryConditions": "off"
      },
      "performance": {
        // Surveyed all ~33 flagged sites: the large majority are inline
        // handlers inside `.map()` list rendering (settings rows, image-set
        // rows, mask-selection drag handlers) that close over per-item loop
        // variables and can't be hoisted to a stable top-level useCallback
        // without extracting a separate memoized list-item component per
        // call site — a much larger structural change than a lint pass.
        // This is a Tauri desktop app, not a render-heavy web app at scale,
        // so the re-render cost this rule guards against is negligible
        // here. Rather than force-fit useCallback in some places and leave
        // it un-fixable in others (an inconsistent, partially-applied
        // fix), the rule is disabled globally. Genuinely hot paths (e.g.
        // drag handlers) were reviewed individually and are cheap,
        // allocation-light closures.
        "noJsxPropsBind": "off",
        // This app builds with `output: "export"` (static export) for
        // bundling into a Tauri desktop shell — there is no Next.js server
        // to run the Image Optimization API at runtime. next/image would
        // need `images.unoptimized: true` (losing its main benefit) to even
        // load, and nothing in this codebase currently uses it, so plain
        // <img> is the correct choice here rather than the two current
        // call sites migrating to a component that doesn't fit the
        // deployment model.
        "noImgElement": "off"
      }
    }
  },
  "overrides": [
    {
      // The two end-to-end suites. Both rules disabled here are performance
      // rules, and neither measures anything in a test that drives a real
      // browser:
      //
      //  - noAwaitInLoops. Every await in these specs is a round trip to a
      //    browser, and the order is the point -- open the section, then click
      //    the picker, then assert the value landed. Running them concurrently
      //    would not be faster, it would be wrong.
      //  - useTopLevelRegex. A regex literal allocated once per test is
      //    invisible next to a page navigation. More to the point, a function
      //    handed to `browser.execute` or `page.evaluate` is serialised and
      //    sent to the browser, so it *cannot* close over a module-level
      //    constant: hoisting the regex would break it outright.
      "includes": ["e2e-web/**", "e2e-tests/**"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      // Biome 2.5.3 panics internally ("processing panicked: index out of
      // bounds", inside biome_module_graph::module_resolver) whenever it
      // tries to process these two files, likely due to the parenthesized
      // Next.js route-group directory segments in their paths ("(image)",
      // "(tiff-image)"). This is a Biome bug, not a project preference —
      // exclude them entirely so `ultracite check`/`fix` don't crash.
      "includes": [
        "src/app/pipeline/fs-circular-mas-selection.tsx",
        "src/components/ui/(image)/(tiff-image)/tiff-image.tsx"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      // These files wrap Radix UI primitives. `import * as XPrimitive from
      // "@radix-ui/react-x"` is the pattern Radix's own docs and shadcn/ui
      // use, since each package exports many subcomponents (Root, Trigger,
      // Content, Item, ...) that are all referenced via the namespace.
      // Named-importing every subcomponent individually would be far more
      // verbose for no real benefit (Radix's exports are already
      // tree-shakeable through the namespace object), so noNamespaceImport
      // is disabled here rather than fought file-by-file.
      "includes": [
        "src/components/ui/accordion.tsx",
        "src/components/ui/checkbox.tsx",
        "src/components/ui/context-menu.tsx",
        "src/components/ui/dialog.tsx",
        "src/components/ui/dropdown-menu.tsx",
        "src/components/ui/hover-card.tsx",
        "src/components/ui/label.tsx",
        "src/components/ui/popover.tsx",
        "src/components/ui/progress.tsx",
        "src/components/ui/select.tsx",
        "src/components/ui/separator.tsx",
        "src/components/ui/slider.tsx",
        "src/components/ui/tooltip.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    },
    {
      // Vendored/hand-written ambient type declarations for the untyped
      // "tiff.js" package, copied verbatim from
      // https://github.com/seikichi/tiff.js/blob/master/tiff.d.ts (see the
      // comment in tiff.d.ts) since tiff.js ships no types of its own.
      // `any` and `namespace` are exactly how the upstream declaration
      // models this legacy Emscripten-based library; rewriting them would
      // just be re-deriving upstream's own (untyped) API shape rather than
      // fixing anything in our code.
      "includes": ["types/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNamespace": "off"
          }
        }
      }
    },
    {
      // Renders an arbitrary user-selected photo at whatever size its
      // parent container happens to be (`size-full object-contain`); unlike
      // navigation.tsx's logo, there is no fixed intrinsic size to declare
      // up front, so a width/height attribute pair would just be wrong.
      "includes": ["src/components/ui/(image)/generic-image.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "useImageSize": "off"
          }
        }
      }
    },
    {
      // These files run in the browser (webview) and need Node's `path`
      // module polyfilled there via path-browserify, for tiff.js/file-path
      // handling on user-selected files. next.config.js's webpack
      // `resolve.fallback` (and the Turbopack `resolveAlias`) only rewrite
      // the bare "path" specifier to that polyfill, not "node:path" — using
      // the node: prefix here breaks `next build`, which failed with
      // "UnhandledSchemeError: Reading from 'node:path' is not handled by
      // plugins" when ultracite's unsafe fix rewrote these imports. Keep
      // the bare specifier so the browser bundle keeps working.
      "includes": [
        "src/app/viewer/page.tsx",
        "src/components/ui/image-matrix-input.tsx",
        "src/components/ui/image-set-preview.tsx",
        "src/components/ui/(image)/generic-image.tsx",
        "src/lib/generic-image-metadata.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNodejsImportProtocol": "off"
          }
        }
      }
    },
    {
      // Renaming this file to use-tiff-path.tsx would require editing its
      // only consumer's import statement, but that consumer
      // (tiff-image.tsx) is excluded from all Biome processing above due
      // to an internal Biome crash — editing an excluded file's imports is
      // out of scope for a lint fix. Scoped to this exact file only.
      "includes": ["src/components/ui/(image)/(tiff-image)/useTiffPath.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
